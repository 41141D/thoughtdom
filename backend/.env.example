# --- REQUIRED ---
DATABASE_URL=postgresql://postgres:<YOUR_PG_PASSWORD>@db.<YOUR_PROJECT>.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=<generate 32+ random characters; never use the dev default in production>

# --- REQUIRED for image uploads ---
SUPABASE_URL=https://<YOUR_PROJECT>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role secret — backend only, never expose>

# --- REQUIRED: comma-separated list of your frontend origins (no spaces) ---
CORS_ORIGINS=https://thought-dom.vercel.app,http://localhost:3000

# --- REQUIRED for anti-abuse rate limiting (get from Render: create a free Redis instance) ---
REDIS_URL=redis://<YOUR_RENDER_REDIS>:6379

# The frontend only needs ONE env var: NEXT_PUBLIC_API_URL=https://<backend>.onrender.com
